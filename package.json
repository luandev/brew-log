{
  "name": "brew-log",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "data": "node scripts/run_generate.mjs",
    "start": "npm run data && expo start",
    "web": "npm run data && expo start --web",
    "export:web": "npm run data && expo export --platform web && node scripts/prepare_dist.mjs",
    "serve:export": "node scripts/serve-export.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "marked": "^15.0.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
